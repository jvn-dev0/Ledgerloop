NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never use this in browser code or commit its value.
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Developer Sandbox credentials (the client ID is public; the secret is server-only).
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Used to generate customer-facing payment links.
APP_URL=http://localhost:3000
