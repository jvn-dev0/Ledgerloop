NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (preferred) or legacy service-role key.
# Both bypass RLS. Never prefix with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Developer Sandbox credentials (the client ID is public; the secret is server-only).
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Used to generate customer-facing payment links.
APP_URL=http://localhost:3008

# Server-only Groq inference. Qwen 3.8 is currently listed as Preview.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional writable model cache path; defaults to the operating-system temp directory.
TRANSFORMERS_CACHE_DIR=
